package com.krakedev;

public class Rectangulo {
	
	//atributos de la clase
	public int base;
	public int altura;
	
	//creamos la funcion
	public int calcularArea() {
		int area = base*altura;
		return area;
	}
	
	public double calcularPerimetro() {
		double perimetro = base+base+altura+altura;
		return perimetro;
	}
	
}
